# Copy to .env and fill in.

# PostgreSQL. With docker compose:  postgresql://kantemba:kantemba@localhost:5432/kantemba?schema=public
DATABASE_URL="postgresql://kantemba:kantemba@localhost:5432/kantemba?schema=public"

# Throwaway database for the tests. The database tests are skipped when this is empty.
TEST_DATABASE_URL="postgresql://kantemba:kantemba@localhost:5432/kantemba_test?schema=public"

# 32+ random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Demo shop created by `npm run db:seed`
SEED_OWNER_EMAIL="owner@kantemba.test"
SEED_OWNER_PASSWORD=""
